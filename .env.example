# ==============================================================================
# AETHER PLATFORM — COMPREHENSIVE 10-TIER ENVIRONMENT VARIABLE MATRIX
# ==============================================================================
# Usage:
#   Copy this template to .env.local for local development:
#   cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION RUNTIME
# ------------------------------------------------------------------------------
# Options: 'development' | 'staging' | 'production'
NODE_ENV=development
APP_ENV=development
APP_NAME="Aether Sovereign Platform"
APP_URL=http://localhost:3000
PUBLIC_MARKETING_URL=http://localhost:3000
PORT=8080
GRPC_PORT=9090

# Logging: 'trace' | 'debug' | 'info' | 'warn' | 'error'
LOG_LEVEL=debug
JSON_LOGGING=false # Set to true in staging and production

# ------------------------------------------------------------------------------
# 2. CORS & SECURITY
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins for browser clients
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8080,https://aether.io,https://app.aether.io"

# 32-byte hexadecimal secret key for encrypting sensitive tenant secrets at rest
# Generate with: openssl rand -hex 32
ENCRYPTION_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# JWT signature secret for stateless worker authentication & session tokens
JWT_SIGNING_SECRET=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210
JWT_EXPIRATION_HOURS=24

# Cryptographic Action Non-Repudiation (ed25519)
ED25519_PRIVATE_KEY_HEX=
ED25519_PUBLIC_KEY_HEX=

# ------------------------------------------------------------------------------
# 3. DATABASE & PERSISTENCE (POSTGRESQL 16 + PGVECTOR)
# ------------------------------------------------------------------------------
# Local: postgresql://aether_app:aether_dev_password@localhost:5432/aether_dev
# Production: postgresql://aether_app:${DB_PASS}@aurora-cluster.prod.internal:5432/aether_prod?sslmode=require
DATABASE_URL=postgresql://aether_app:aether_dev_password@localhost:5432/aether_dev
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=20
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=10000

# ------------------------------------------------------------------------------
# 4. DISTRIBUTED CACHE & WRITE-AHEAD LOG (REDIS & NATS JETSTREAM)
# ------------------------------------------------------------------------------
# Redis / Dragonfly URL (L1 context cache, distributed locks, rate-limiting)
REDIS_URL=redis://:aether_dev_redis@localhost:6379/0
REDIS_CLUSTER_MODE=false # Set true for Redis Enterprise / ElastiCache Cluster
REDIS_MAX_CONNECTIONS=50

# NATS JetStream (Raft-backed event fabric & distributed task queue)
NATS_URL=nats://localhost:4222
NATS_CLUSTER_ID=aether-cluster
NATS_STREAM_NAME=AETHER_EVENTS
NATS_CONSUMER_ACK_TIMEOUT_SECONDS=15

# ------------------------------------------------------------------------------
# 5. VECTOR & MEMORY FABRIC (PGVECTOR / QDRANT)
# ------------------------------------------------------------------------------
# Vector backend provider: 'pgvector' | 'qdrant'
VECTOR_STORE_PROVIDER=pgvector
DEFAULT_VECTOR_DIMENSION=1536

# Qdrant configuration (optional if using pgvector)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Embedding Provider: 'openai' | 'fastembed' | 'ollama'
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# ------------------------------------------------------------------------------
# 6. EXTERNAL LLM PROVIDERS & MODEL GATEWAY
# ------------------------------------------------------------------------------
# Commercial API Keys
OPENAI_API_KEY=sk-proj-placeholder
ANTHROPIC_API_KEY=sk-ant-placeholder
GROQ_API_KEY=gsk-placeholder

# Self-Hosted / Local LLM Inference (vLLM, TensorRT-LLM, Ollama)
LOCAL_OLLAMA_BASE_URL=http://localhost:11434
LOCAL_VLLM_BASE_URL=http://localhost:8000/v1

# Model Routing & Circuit Breaking
DEFAULT_FALLBACK_MODEL=claude-3-5-sonnet
CIRCUIT_BREAKER_FAILURE_THRESHOLD_PCT=35
CIRCUIT_BREAKER_ROLLING_WINDOW_SECONDS=30

# ------------------------------------------------------------------------------
# 7. AUTHENTICATION & IDENTITY (CLERK / WORKOS / OIDC)
# ------------------------------------------------------------------------------
# Next.js Client & Server Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder
CLERK_SIGN_IN_URL=/sign-in
CLERK_SIGN_UP_URL=/sign-up
CLERK_AFTER_SIGN_IN_URL=/dashboard
CLERK_AFTER_SIGN_UP_URL=/onboarding
CLERK_WEBHOOK_SECRET=whsec_placeholder

# SPIFFE / SPIRE mTLS configuration (Worker Plane)
SPIFFE_TRUST_DOMAIN=aether.internal
SPIFFE_SOCKET_PATH=/tmp/spire-agent/public/api.sock

# ------------------------------------------------------------------------------
# 8. BILLING & COMMERCE (STRIPE)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_PRO_TIER_PRICE_ID=price_placeholder_pro
STRIPE_ENTERPRISE_TIER_PRICE_ID=price_placeholder_enterprise

# ------------------------------------------------------------------------------
# 9. TELEMETRY, ANALYTICS & OBSERVABILITY
# ------------------------------------------------------------------------------
# PostHog Product Analytics
NEXT_PUBLIC_POSTHOG_KEY=phc_placeholder
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry Error Monitoring
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ENVIRONMENT=development

# OpenTelemetry GenAI Semantic Spans & Metrics
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=aether-control-plane

# ------------------------------------------------------------------------------
# 10. OBJECT STORAGE & CHECKPOINTS (S3 / MINIO / CLOUDFLARE R2)
# ------------------------------------------------------------------------------
# Local MinIO or Cloudflare R2 / AWS S3
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET_NAME=aether-checkpoints
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=aether_minio_admin
STORAGE_SECRET_ACCESS_KEY=aether_minio_password
STORAGE_FORCE_PATH_STYLE=true # Set to false for native AWS S3 virtual-hosted buckets
